# Generated artifacts (regenerate with run.py)
logs/
plots/

# cflib's own radio TOC cache (keyed by CRC, unrelated to experiment data) --
# regenerates automatically on the next hardware connect.
cache/

# Flight-input waypoints (waypoints/pdstl_fan<L>.json) ARE tracked — they are
# what `run.py fly` loads. Only the generated figures/logs/cache above are
# ignored.

# The repo root's .gitignore has a blanket (unscoped) "config.yml" rule --
# this experiment's config.yml is the tracked source of truth for every
# input value (arena geometry, uncertainty model, planner/flight params),
# not a generated or user-local file, so un-ignore it here.
!config.yml
